{
  "name": "@tinfoilhash/hasheus",
  "version": "2.1.0",
  "private": true,
  "description": "verify the integrity of a file with the largest decentralized web of trust",
  "bugs": "https://github.com/tinfoilhash/hasheus/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinfoilhash/hasheus.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:relay": "nak serve --events dev/seed.jsonl",
    "dev:seed": "node dev/seed.js",
    "build": "vp build",
    "preview": "vp preview",
    "lint": "vp check && vp run lint:style",
    "lint:fix": "vp check --fix && vp run lint:style:fix",
    "lint:style": "stylelint '**/*.js'",
    "lint:style:fix": "stylelint --fix '**/*.js'",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:coverage": "vp test --coverage",
    "test:e2e": "playwright test",
    "release": "release-it --only-version"
  },
  "dependencies": {
    "@lit-labs/router": "^0.1.4",
    "@lit/task": "^1.0.3",
    "@noble/hashes": "2.0.1",
    "lit": "^3.3.3",
    "modern-normalize": "^3.0.1",
    "nostr-tools": "^2.25.5",
    "urlpattern-polyfill": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-lit": "^2.3.1",
    "postcss-lit": "^1.4.1",
    "release-it": "^21.1.2",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.10.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.x"
    },
    "runtime": {
      "name": "node",
      "version": "26.x"
    }
  }
}
